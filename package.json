  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "build:server": "tsc -b && tsc -p tsconfig.server.json && vite build --base=/",
